# Copy to: /etc/travelflow/travelflow.env

# Required
DASHSCOPE_API_KEY=your_dashscope_api_key
APP_JWT_SECRET=replace_with_a_long_random_secret

# Recommended
APP_CORS_ALLOWED_ORIGINS=https://www.smarttravel.cn,https://smarttravel.cn
APP_JWT_EXPIRE_SECONDS=86400

# Optional
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=travel_knowledge
QDRANT_VECTOR_DIMENSION=1024
